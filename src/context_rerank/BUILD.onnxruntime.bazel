# ONNX Runtime の C++ 版（配布済みのビルド）。MODULE.bazel の new_local_repository から使う。
# Linux は onnxruntime-linux-x64-1.30.0、Windows は onnxruntime-win-x64-1.30.0 を指す。

load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")

cc_import(
    name = "onnxruntime_so",
    shared_library = "lib/libonnxruntime.so.1",
)

# Windows：DLL と import ライブラリ。DLL は依存する実行ファイルの隣に写される
cc_import(
    name = "onnxruntime_dll",
    interface_library = "lib/onnxruntime.lib",
    shared_library = "lib/onnxruntime.dll",
)

cc_library(
    name = "onnxruntime",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    # Windows：DLL がなくても起動できるよう遅延読み込みにする（読み込みは lm_scorer.cc の LmScorer::Load）
    linkopts = select({
        "@platforms//os:windows": [
            "/DELAYLOAD:onnxruntime.dll",
            "delayimp.lib",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = select({
        "@platforms//os:windows": [":onnxruntime_dll"],
        "//conditions:default": [":onnxruntime_so"],
    }),
)
